{
  "manifest_version": 3,
  "name": "CriptoPrice",
  "version": "1.1.0",
  "description": "Mostra o preço atual do Bitcoin e do Ethereum em BRL ou USD via CoinGecko.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CriptoPrice",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": []
}
